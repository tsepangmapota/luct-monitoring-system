{
  "name": "limkokwing-monitor",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "start:phone": "powershell -ExecutionPolicy Bypass -File scripts/start-phone.ps1",
    "start:lan": "expo start --lan",
    "start:tunnel": "expo start --tunnel",
    "start:dev-client": "expo start --dev-client --lan",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web --output-dir dist",
    "deploy:firebase": "npm run build:web && firebase deploy --only hosting"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.23",
    "firebase": "^12.11.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@react-native-community/cli": "^20.1.3",
    "babel-preset-expo": "~54.0.7"
  }
}
